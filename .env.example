# Salin fail ini kepada .env dan isi nilainya

# Kunci Claude API (daripada console.anthropic.com). Pengguna aplikasi tidak perlu akaun Claude.
# RM_ANTHROPIC_API_KEY diutamakan; ANTHROPIC_API_KEY juga diterima.
# Dalam sesi awan Claude Code, gunakan RM_ANTHROPIC_API_KEY (nama ANTHROPIC_API_KEY dikhaskan).
RM_ANTHROPIC_API_KEY=

# Akaun admin: e-mel sebagai nama pengguna, kata laluan ditetapkan semasa penyediaan
ADMIN_EMAIL=kreatifkursus@gmail.com
ADMIN_PASSWORD=

PORT=3000
NODE_ENV=production

# Had panggilan AI bagi setiap pengguna sejam
AI_LIMIT_PER_HOUR=60
